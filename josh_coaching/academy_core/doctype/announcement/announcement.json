{
 "doctype": "DocType",
 "name": "Announcement",
 "module": "Academy Core",
 "custom": 0,
 "istable": 0,
 "is_submittable": 1,
 "editable_grid": 1,
 "track_changes": 1,
 "autoname": "format:ANNC-{YYYY}{MM}-{#####}",
 "title_field": "title",
 "show_title_field_in_link": 1,
 "fields": [
  {
   "fieldname": "title",
   "fieldtype": "Data",
   "label": "Title",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "column_break_0",
   "fieldtype": "Column Break",
   "label": ""
  },
  {
   "fieldname": "publish_date",
   "fieldtype": "Date",
   "label": "Publish Date",
   "reqd": 1,
   "default": "Today"
  },
  {
   "fieldname": "section_body",
   "fieldtype": "Section Break",
   "label": ""
  },
  {
   "fieldname": "message",
   "fieldtype": "Text Editor",
   "label": "Message",
   "reqd": 1
  },
  {
   "fieldname": "section_audience",
   "fieldtype": "Section Break",
   "label": "Audience"
  },
  {
   "fieldname": "audience_type",
   "fieldtype": "Select",
   "label": "Send To",
   "options": "All Students\nSelected Batches\nSelected Students\nAll Trainers",
   "default": "All Students",
   "reqd": 1
  },
  {
   "fieldname": "batches",
   "fieldtype": "Table MultiSelect",
   "label": "Batches",
   "options": "Announcement Batch",
   "depends_on": "eval:doc.audience_type==='Selected Batches'"
  },
  {
   "fieldname": "students",
   "fieldtype": "Table MultiSelect",
   "label": "Students",
   "options": "Announcement Student",
   "depends_on": "eval:doc.audience_type==='Selected Students'"
  },
  {
   "fieldname": "column_break_1",
   "fieldtype": "Column Break",
   "label": ""
  },
  {
   "fieldname": "send_whatsapp",
   "fieldtype": "Check",
   "label": "Also Send WhatsApp/SMS",
   "default": "0"
  },
  {
   "fieldname": "recipients_notified",
   "fieldtype": "Int",
   "label": "Recipients Notified",
   "read_only": 1
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1, "write": 1, "create": 1, "delete": 1, "submit": 1, "cancel": 1
  },
  {
   "role": "Academy Manager",
   "read": 1, "write": 1, "create": 1, "delete": 1, "submit": 1, "cancel": 1
  },
  {
   "role": "Academy User",
   "read": 1
  }
 ]
}
