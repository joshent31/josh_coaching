{
 "doctype": "DocType",
 "name": "Lead Inquiry",
 "module": "Academy Core",
 "custom": 0,
 "istable": 0,
 "is_submittable": 0,
 "editable_grid": 1,
 "track_changes": 1,
 "autoname": "format:LEAD-{YYYY}-{#####}",
 "title_field": "lead_name",
 "show_title_field_in_link": 1,
 "fields": [
  {
   "fieldname": "lead_name",
   "fieldtype": "Data",
   "label": "Lead Name",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "mobile",
   "fieldtype": "Data",
   "label": "Mobile",
   "options": "Phone",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "email",
   "fieldtype": "Data",
   "label": "Email",
   "options": "Email"
  },
  {
   "fieldname": "column_break_0",
   "fieldtype": "Column Break",
   "label": ""
  },
  {
   "fieldname": "interested_program",
   "fieldtype": "Link",
   "label": "Interested Program",
   "options": "Program",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "source",
   "fieldtype": "Select",
   "label": "Source",
   "options": "Walk-in\nPhone\nWebsite\nSocial Media\nReferral\nEvent\nOther",
   "default": "Walk-in",
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "section_trial",
   "fieldtype": "Section Break",
   "label": "Trial Class"
  },
  {
   "fieldname": "trial_sessions_allowed",
   "fieldtype": "Int",
   "label": "Trial Sessions Allowed",
   "default": "2"
  },
  {
   "fieldname": "trial_date",
   "fieldtype": "Date",
   "label": "Trial Date",
   "in_list_view": 1
  },
  {
   "fieldname": "trial_batch",
   "fieldtype": "Link",
   "label": "Trial Batch",
   "options": "Batch"
  },
  {
   "fieldname": "column_break_1",
   "fieldtype": "Column Break",
   "label": ""
  },
  {
   "fieldname": "trial_status",
   "fieldtype": "Select",
   "label": "Trial Status",
   "options": "\nScheduled\nAttended\nNo Show\nConverted",
   "in_standard_filter": 1
  },
  {
   "fieldname": "trial_feedback",
   "fieldtype": "Small Text",
   "label": "Trial Feedback"
  },
  {
   "fieldname": "section_followup",
   "fieldtype": "Section Break",
   "label": "Follow-up"
  },
  {
   "fieldname": "followup_date",
   "fieldtype": "Date",
   "label": "Next Follow-up",
   "in_list_view": 1
  },
  {
   "fieldname": "assigned_to",
   "fieldtype": "Link",
   "label": "Assigned To",
   "options": "User"
  },
  {
   "fieldname": "column_break_2",
   "fieldtype": "Column Break",
   "label": ""
  },
  {
   "fieldname": "notes",
   "fieldtype": "Small Text",
   "label": "Notes"
  },
  {
   "fieldname": "section_conversion",
   "fieldtype": "Section Break",
   "label": "Conversion"
  },
  {
   "fieldname": "converted_student",
   "fieldtype": "Link",
   "label": "Converted Student",
   "options": "Student",
   "read_only": 1
  },
  {
   "fieldname": "column_break_3",
   "fieldtype": "Column Break",
   "label": ""
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "New\nIn Progress\nConverted\nLost",
   "default": "New",
   "in_list_view": 1,
   "in_standard_filter": 1
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  },
  {
   "role": "Academy Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  },
  {
   "role": "Academy User",
   "read": 1,
   "write": 1,
   "create": 1
  }
 ]
}
