{
 "doctype": "DocType",
 "name": "Coaching Event",
 "module": "Academy Core",
 "custom": 0,
 "istable": 0,
 "is_submittable": 0,
 "editable_grid": 1,
 "track_changes": 1,
 "autoname": "format:EVENT-{YYYY}-{#####}",
 "title_field": "event_name",
 "show_title_field_in_link": 1,
 "fields": [
  {
   "fieldname": "event_name",
   "fieldtype": "Data",
   "label": "Event Name",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "event_type",
   "fieldtype": "Select",
   "label": "Type",
   "options": "Tournament\nCompetition\nGrading Test\nWorkshop\nSummer Camp\nExhibition\nOther",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "column_break_0",
   "fieldtype": "Column Break",
   "label": ""
  },
  {
   "fieldname": "program",
   "fieldtype": "Link",
   "label": "Program",
   "options": "Program",
   "in_standard_filter": 1
  },
  {
   "fieldname": "coaching_center",
   "fieldtype": "Link",
   "label": "Host Center",
   "options": "Coaching Center"
  },
  {
   "fieldname": "section_dates",
   "fieldtype": "Section Break",
   "label": "Schedule"
  },
  {
   "fieldname": "start_date",
   "fieldtype": "Date",
   "label": "Start Date",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "end_date",
   "fieldtype": "Date",
   "label": "End Date"
  },
  {
   "fieldname": "column_break_1",
   "fieldtype": "Column Break",
   "label": ""
  },
  {
   "fieldname": "venue",
   "fieldtype": "Data",
   "label": "Venue"
  },
  {
   "fieldname": "section_fees",
   "fieldtype": "Section Break",
   "label": "Fees"
  },
  {
   "fieldname": "entry_fee",
   "fieldtype": "Currency",
   "label": "Entry Fee",
   "options": "currency"
  },
  {
   "fieldname": "currency",
   "fieldtype": "Link",
   "label": "Currency",
   "options": "Currency",
   "default": "INR"
  },
  {
   "fieldname": "fee_component",
   "fieldtype": "Link",
   "label": "Fee Component",
   "options": "Fee Component",
   "default": "Event or Competition"
  },
  {
   "fieldname": "column_break_2",
   "fieldtype": "Column Break",
   "label": ""
  },
  {
   "fieldname": "max_participants",
   "fieldtype": "Int",
   "label": "Max Participants"
  },
  {
   "fieldname": "registered_count",
   "fieldtype": "Int",
   "label": "Registered",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "section_notes",
   "fieldtype": "Section Break",
   "label": ""
  },
  {
   "fieldname": "description",
   "fieldtype": "Text Editor",
   "label": "Description"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Draft\nOpen for Registration\nOngoing\nCompleted\nCancelled",
   "default": "Draft",
   "in_list_view": 1,
   "in_standard_filter": 1
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1, "write": 1, "create": 1, "delete": 1
  },
  {
   "role": "Academy Manager",
   "read": 1, "write": 1, "create": 1, "delete": 1
  },
  {
   "role": "Academy User",
   "read": 1, "write": 1, "create": 1
  },
  {
   "role": "Trainer",
   "read": 1
  }
 ]
}
