[
 {
  "doctype": "Print Format",
  "name": "Fee Receipt Print",
  "doc_type": "Fee Receipt",
  "module": "Fees Management",
  "print_format_type": "Jinja",
  "standard": "Yes",
  "html": "<div class=\"print-format\">\n  <h2 style=\"margin-bottom:2px;\">Fee Receipt</h2>\n  <p style=\"color:#666;margin-top:0;\">Receipt {{ doc.name }}</p>\n  <table class=\"table table-bordered\">\n    <tr><td><b>Receipt No</b></td><td>{{ doc.name }}</td><td><b>Date</b></td><td>{{ doc.posting_date }}</td></tr>\n    <tr><td><b>Student</b></td><td>{{ doc.student_name or doc.student }}</td><td><b>Invoice</b></td><td>{{ doc.invoice or '' }}</td></tr>\n    <tr><td><b>Amount Paid</b></td><td><b>{{ doc.currency }} {{ doc.amount }}</b></td><td><b>Mode</b></td><td>{{ doc.mode_of_payment or '' }}</td></tr>\n  </table>\n  <p style=\"margin-top:24px;\">Authorised Signatory</p>\n</div>"
 },
 {
  "doctype": "Print Format",
  "name": "Student ID Card",
  "doc_type": "Student",
  "module": "Student Management",
  "print_format_type": "Jinja",
  "standard": "Yes",
  "html": "<div class=\"print-format\" style=\"max-width:420px;\">\n  <div style=\"border:2px solid #333;border-radius:12px;padding:16px;display:flex;gap:16px;align-items:center;\">\n    <div style=\"flex:1;\">\n      <h3 style=\"margin:0 0 8px 0;\">{{ doc.student_name }}</h3>\n      <p style=\"margin:2px 0;\"><b>ID:</b> {{ doc.student_id or doc.name }}</p>\n      <p style=\"margin:2px 0;\"><b>DOB:</b> {{ doc.date_of_birth or '' }}</p>\n      <p style=\"margin:2px 0;\"><b>Status:</b> {{ doc.status }}</p>\n      <p style=\"margin:2px 0;font-size:11px;color:#555;\">Scan at the front desk for check-in</p>\n    </div>\n    <div>\n      <img src=\"data:image/png;base64,{{ qr_data or '' }}\" style=\"width:120px;height:120px;\" />\n    </div>\n  </div>\n</div>"
 },
 {
  "doctype": "Print Format",
  "name": "Session Check-in Poster",
  "doc_type": "Class Session",
  "module": "Scheduling",
  "print_format_type": "Jinja",
  "standard": "Yes",
  "html": "<div class=\"print-format\" style=\"text-align:center;\">\n  <h2>Session Check-in</h2>\n  <p style=\"font-size:16px;\"><b>{{ doc.batch }}</b> &mdash; {{ doc.session_date }} {{ doc.start_time }} - {{ doc.end_time }}</p>\n  <p style=\"color:#666;\">{{ doc.venue or '' }}</p>\n  <img src=\"data:image/png;base64,{{ qr_data or '' }}\" style=\"width:280px;height:280px;\" />\n  <p style=\"margin-top:12px;color:#888;\">Scan this code when you arrive. Valid for {{ doc.checkin_window_minutes }} minutes after generation.</p>\n</div>"
 }
]
