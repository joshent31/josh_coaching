{
 "doctype": "DocType",
 "name": "Fee Refund",
 "module": "Fees Management",
 "custom": 0,
 "istable": 0,
 "is_submittable": 1,
 "editable_grid": 1,
 "track_changes": 1,
 "autoname": "format:REF-{YYYY}-{#####}",
 "title_field": "student",
 "show_title_field_in_link": 1,
 "fields": [
  {
   "fieldname": "student",
   "fieldtype": "Link",
   "label": "Student",
   "options": "Student",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "student_name",
   "fieldtype": "Data",
   "label": "Student Name",
   "fetch_from": "student.student_name",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "column_break_0",
   "fieldtype": "Column Break",
   "label": ""
  },
  {
   "fieldname": "payment",
   "fieldtype": "Link",
   "label": "Against Payment",
   "options": "Fee Payment",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "invoice",
   "fieldtype": "Link",
   "label": "Fee Invoice",
   "options": "Fee Invoice",
   "fetch_from": "payment.invoice",
   "read_only": 1
  },
  {
   "fieldname": "section_amount",
   "fieldtype": "Section Break",
   "label": ""
  },
  {
   "fieldname": "amount",
   "fieldtype": "Currency",
   "label": "Refund Amount",
   "reqd": 1,
   "options": "currency"
  },
  {
   "fieldname": "currency",
   "fieldtype": "Link",
   "label": "Currency",
   "options": "Currency",
   "reqd": 1
  },
  {
   "fieldname": "column_break_1",
   "fieldtype": "Column Break",
   "label": ""
  },
  {
   "fieldname": "reason",
   "fieldtype": "Select",
   "label": "Reason",
   "options": "Withdrawal\nBatch Closed\nDuplicate Payment\nService Issue\nEquipment Deposit\nOther",
   "reqd": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "refund_date",
   "fieldtype": "Date",
   "label": "Refund Date",
   "reqd": 1,
   "default": "Today"
  },
  {
   "fieldname": "section_gateway",
   "fieldtype": "Section Break",
   "label": "Mode"
  },
  {
   "fieldname": "mode_of_payment",
   "fieldtype": "Select",
   "label": "Refund Mode",
   "options": "Cash\nBank Transfer\nUPI\nOnline Gateway (reverse)\nCheque",
   "default": "Bank Transfer",
   "reqd": 1
  },
  {
   "fieldname": "reference_no",
   "fieldtype": "Data",
   "label": "Reference No"
  },
  {
   "fieldname": "column_break_2",
   "fieldtype": "Column Break",
   "label": ""
  },
  {
   "fieldname": "adjust_outstanding",
   "fieldtype": "Check",
   "label": "Adjust Against Outstanding",
   "default": "1",
   "description": "Reduce the invoice outstanding instead of a cash refund."
  },
  {
   "fieldname": "remarks",
   "fieldtype": "Small Text",
   "label": "Remarks"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Draft\nProcessed\nCancelled",
   "default": "Draft"
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1, "write": 1, "create": 1, "delete": 1, "submit": 1, "cancel": 1
  },
  {
   "role": "Academy Manager",
   "read": 1, "write": 1, "create": 1, "delete": 1, "submit": 1, "cancel": 1
  }
 ]
}
