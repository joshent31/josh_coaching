   "label": "Payment",
   "options": "Fee Payment",
   "reqd": 1
  },
  {
   "fieldname": "invoice",
   "fieldtype": "Link",
   "label": "Fee Invoice",
   "options": "Fee Invoice",
   "in_list_view": 1
  },
  {
   "fieldname": "section_amount",
   "fieldtype": "Section Break",
   "label": ""
  },
  {
   "fieldname": "amount",
   "fieldtype": "Currency",
   "label": "Amount",
   "reqd": 1,
   "options": "currency",
