{
 "doctype": "DocType",
 "name": "Student Attendance",
 "module": "Student Management",
 "custom": 0,
 "istable": 0,
 "is_submittable": 0,
 "editable_grid": 1,
 "track_changes": 1,
 "autoname": "format:ATT-{YYYY}{MM}{DD}-{########}",
 "fields": [
  {
   "fieldname": "student",
   "fieldtype": "Link",
   "label": "Student",
   "options": "Student",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "student_name",
   "fieldtype": "Data",
   "label": "Student Name",
   "fetch_from": "student.student_name",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "column_break_0",
   "fieldtype": "Column Break",
   "label": ""
  },
  {
   "fieldname": "class_session",
   "fieldtype": "Link",
   "label": "Class Session",
   "options": "Class Session",
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "batch",
   "fieldtype": "Link",
   "label": "Batch",
   "options": "Batch",
   "fetch_from": "class_session.batch",
   "in_standard_filter": 1
  },
  {
   "fieldname": "section_details",
   "fieldtype": "Section Break",
   "label": "Details"
  },
  {
   "fieldname": "attendance_date",
   "fieldtype": "Date",
   "label": "Date",
   "reqd": 1,
   "default": "Today",
   "in_list_view": 1
  },
  {
   "fieldname": "present",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Present\nAbsent\nLate\nExcused",
   "default": "Present",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "column_break_1",
   "fieldtype": "Column Break",
   "label": ""
  },
  {
   "fieldname": "checkin_time",
   "fieldtype": "Datetime",
   "label": "Check-in Time",
   "read_only": 1
  },
  {
   "fieldname": "checkin_method",
   "fieldtype": "Select",
   "label": "Check-in Method",
   "options": "\nManual\nQR Code\nPortal",
   "default": "Manual",
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "marked_by",
   "fieldtype": "Link",
   "label": "Marked By",
   "options": "User",
   "read_only": 1
  },
  {
   "fieldname": "remarks",
   "fieldtype": "Small Text",
   "label": "Remarks"
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  },
  {
   "role": "Academy Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  },
  {
   "role": "Academy User",
   "read": 1,
   "write": 1,
   "create": 1
  },
  {
   "role": "Trainer",
   "read": 1,
   "write": 1,
   "create": 1
  }
 ]
}
