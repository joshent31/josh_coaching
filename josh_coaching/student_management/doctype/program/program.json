{
 "doctype": "DocType",
 "name": "Program",
 "module": "Student Management",
 "custom": 0,
 "istable": 0,
 "is_submittable": 0,
 "editable_grid": 1,
 "track_changes": 1,
 "autoname": "format:{discipline_abbr}-{program_name}",
 "fields": [
  {
   "fieldname": "program_name",
   "fieldtype": "Data",
   "label": "Program Name",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "discipline",
   "fieldtype": "Link",
   "label": "Discipline",
   "options": "Sports Discipline",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "column_break_0",
   "fieldtype": "Column Break",
   "label": ""
  },
  {
   "fieldname": "level",
   "fieldtype": "Select",
   "label": "Level",
   "options": "Beginner\nIntermediate\nAdvanced\nCompetitive\nRecreational",
   "default": "Beginner",
   "in_list_view": 1
  },
  {
   "fieldname": "coaching_center",
   "fieldtype": "Link",
   "label": "Coaching Center",
   "options": "Coaching Center"
  },
  {
   "fieldname": "section_details",
   "fieldtype": "Section Break",
   "label": "Details"
  },
  {
   "fieldname": "description",
   "fieldtype": "Text Editor",
   "label": "Description"
  },
  {
   "fieldname": "duration_weeks",
   "fieldtype": "Int",
   "label": "Duration (Weeks)"
  },
  {
   "fieldname": "column_break_1",
   "fieldtype": "Column Break",
   "label": ""
  },
  {
   "fieldname": "session_duration_minutes",
   "fieldtype": "Int",
   "label": "Session Duration (Minutes)",
   "default": "60"
  },
  {
   "fieldname": "age_group",
   "fieldtype": "Data",
   "label": "Age Group",
   "description": "Free text, e.g. 6-12, Teens, Adults."
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Draft\nActive\nArchived",
   "default": "Draft",
   "in_standard_filter": 1
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  },
  {
   "role": "Academy Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  },
  {
   "role": "Academy User",
   "read": 1
  },
  {
   "role": "Trainer",
   "read": 1
  }
 ]
}
